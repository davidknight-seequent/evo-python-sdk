# Copy these settings into a .env file beside the script or in your current directory.
# Use public/native client IDs, not client secrets or access tokens.
EVO_COPY_SOURCE_CLIENT_ID=
EVO_COPY_SOURCE_REDIRECT_URI=http://localhost:3000/signin-callback
EVO_COPY_SOURCE_IMS_URL=https://ims.bentley.com
EVO_COPY_SOURCE_DISCOVERY_URL=https://discover.api.seequent.com

EVO_COPY_DESTINATION_CLIENT_ID=
EVO_COPY_DESTINATION_REDIRECT_URI=http://localhost:3001/signin-callback
EVO_COPY_DESTINATION_IMS_URL=
EVO_COPY_DESTINATION_DISCOVERY_URL=

# Parent folder for archives; each run creates a new timestamped subfolder inside it.
EVO_COPY_OUTPUT_DIR=~/evo-workspace-copy
